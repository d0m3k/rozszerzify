# Rozszerzify configuration
# Copy to .env (never commit!) and fill in your values.
# On the VPS the real .env lives at /opt/rozszerzify/.env

# PostgreSQL — mikr.us shared instance, same one rybaspotting uses.
# We use our own rz_* tables inside the same database.
DATABASE_URL=postgres://user:password@psql01.mikr.us:5432/db_amy135?sslmode=disable

# JWT secret for signing tokens (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-random-secret

# Listen address (127.0.0.1:8081 behind nginx; 8081 to avoid clashing
# with rybaspotting which owns 8080)
LISTEN_ADDR=127.0.0.1:8081

# Public origin of the app (used only for logs right now)
PUBLIC_URL=https://rozszerzify.dom3k.pl

# Day the kid started expanding the diet — used for the "days in" counter
START_DATE=2025-12-15

# Baby's birthday — used for the age counter (Krzyś ur. 15.06)
BIRTH_DATE=2025-06-15

# On first boot, if the database has no user, one is created:
#   username: krzysio
#   password: value of SEED_PASSWORD
# Set this to the real password in .env — it must NOT be committed.
SEED_PASSWORD=change-me

# Pushover notifications (optional — alerts when a food gets its first try
# and when it reaches its target). User key is the personal pushover.net key;
# app token comes from an application you create at pushover.net.
# Both must be set for notifications to work.
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=